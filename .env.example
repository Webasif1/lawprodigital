# Contact form delivery (server-only — never prefix these with NEXT_PUBLIC_).
# On cPanel, use an email account you create under "Email Accounts";
# its "Connect Devices" page lists the SMTP host and port.
SMTP_HOST=mail.lawprodigital.com
SMTP_PORT=465
# "true" for port 465 (SSL), "false" for 587 (STARTTLS). Defaults from the port if omitted.
SMTP_SECURE=true
SMTP_USER=website@lawprodigital.com
SMTP_PASS=change-me
# Where enquiries are delivered, and the From address (defaults to SMTP_USER).
CONTACT_TO=lawprodigital@gmail.com
CONTACT_FROM=website@lawprodigital.com

# Gmail alternative: send through a Gmail account with a Google App Password
# (Google Account → Security → 2-Step Verification → App passwords).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=lawprodigital@gmail.com
# SMTP_PASS=your-16-character-app-password
# CONTACT_FROM=lawprodigital@gmail.com

# Live AI chat (server-only). Without a key the chat widget stays hidden.
# Create a key at https://openrouter.ai/keys and set a monthly credit limit on it.
OPENROUTER_API_KEY=
# Optional: any OpenRouter model ID. Default: google/gemini-2.5-flash-lite (fast, very low cost).
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Analytics and booking. NEXT_PUBLIC_* values are baked in at BUILD time:
# set them before `npm run build`, then rebuild if they change. Empty = not loaded.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
# Optional: send "Book a call" links to an external scheduler instead of the built-in /book-a-call/ page.
NEXT_PUBLIC_BOOKING_URL=

# Built-in booking calendar + Google Sheets lead log (server-only).
# Setup: docs/CPANEL_DEPLOYMENT.md → "Booking calendar and leads sheet".
# Without these the calendar runs in email mode: working hours only, each booking emailed to CONTACT_TO
# for you to confirm by hand, and no sheet rows. Without SMTP as well, the calendar is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# From `node scripts/google-auth.mjs` (run once on your computer).
GOOGLE_REFRESH_TOKEN=
# Calendar that receives bookings and whose busy time blocks slots. "primary" = the account's main calendar.
GOOGLE_CALENDAR_ID=
# The ID in the sheet's URL: docs.google.com/spreadsheets/d/<ID>/edit. Needs tabs named "Bookings" and "Leads".
GOOGLE_SHEET_ID=
# Your working-hours time zone (IANA name). Hours themselves are in src/content/booking.ts.
BOOKING_TIMEZONE=America/New_York

# Search indexing. Vercel deployments are noindexed automatically (production is cPanel).
# SITE_NOINDEX=true forces noindex anywhere; SITE_NOINDEX=false allows indexing on Vercel.
# SITE_NOINDEX=
